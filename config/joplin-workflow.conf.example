# ============================================
# Joplin Dev Workflow Configuration
# ============================================
# 
# This is the configuration file for joplin-dev-workflow CLI tools.
# Copy this file to ~/.config/joplin-workflow/config and customize it.
#
# Installation will automatically create this file if it doesn't exist.
#

# --------------------------------------------
# Joplin Desktop Data API Configuration
# --------------------------------------------
# Base mode writes to Joplin Desktop through the Web Clipper/Data API service.
# In Joplin Desktop, enable:
#   Tools > Options > Web Clipper > Enable Web Clipper Service
#
# Copy the authorization token from that screen into your local config only.
# Do not commit real tokens to this repository.

JOPLIN_WRITE_ADAPTER="data_api"

# Optional. Leave empty to probe localhost ports from JOPLIN_API_PORT_START
# through JOPLIN_API_PORT_END. Joplin Desktop commonly uses 41184.
JOPLIN_API_BASE_URL=""
JOPLIN_API_PORT_START="41184"
JOPLIN_API_PORT_END="41194"
JOPLIN_API_TIMEOUT="5"

# Required for writing notes through Joplin Desktop Data API.
JOPLIN_API_TOKEN=""


# --------------------------------------------
# Notebook Configuration
# --------------------------------------------
# Prefer notebook/folder IDs when possible. IDs avoid ambiguity when multiple
# notebooks share the same title or live under different parent notebooks.
# Leave IDs empty to fall back to notebook title lookup.
#
# First-time setup choices:
#   joplin-workflow-doctor --setup-existing
#     Resolve your existing notebooks and write NOTEBOOK_*_ID values.
#   joplin-workflow-doctor --setup-create-defaults
#     Create new empty Daily Notes, Blog Posts, and Weekly Reviews notebooks
#     only when those titles do not already exist, then write NOTEBOOK_*_ID.

# Notebook for daily TIL (Today I Learned) notes
# Used by: til command
NOTEBOOK_DAILY_ID=""
NOTEBOOK_DAILY="Daily Notes"

# Notebook for learning articles and technical posts
# Used by: learn command
NOTEBOOK_POST_ID=""
NOTEBOOK_POST="Blog Posts"

# Notebook for weekly reviews and progress planning
# Used by: weekly command
NOTEBOOK_WEEKLY_ID=""
NOTEBOOK_WEEKLY="Weekly Reviews"


# --------------------------------------------
# Template Tags
# --------------------------------------------
# Tags automatically added to notes. Use space-separated hashtags.

# Tags for TIL entries
TEMPLATE_TAGS_TIL="#til #daily"

# Tags for learning articles
TEMPLATE_TAGS_LEARN="#article #draft"

# Tags for weekly reviews
TEMPLATE_TAGS_WEEKLY="#weekly #review"


# --------------------------------------------
# Date and Time Format
# --------------------------------------------
# Format strings using standard date command syntax.
# See: https://man7.org/linux/man-pages/man1/date.1.html

# Date format (e.g., 2026-02-16)
DATE_FORMAT="%Y-%m-%d"

# Time format (e.g., 14:30)
TIME_FORMAT="%H:%M"

# Weekly date range format
WEEK_DATE_FORMAT="%Y-%m-%d"


# --------------------------------------------
# TIL Note Configuration
# --------------------------------------------
# Template for the daily TIL note title
# {DATE} will be replaced with current date in DATE_FORMAT
DAILY_NOTE_TITLE_TEMPLATE="{DATE} Daily Notes"

# Example outputs:
#   "2026-02-16 Daily Notes"
#   "2026-02-16 Learning Log"


# --------------------------------------------
# Content Templates (Optional)
# --------------------------------------------
# You can customize note templates by editing the scripts directly,
# or create template files in ~/.config/joplin-workflow/templates/
# (Feature coming in future version)


# --------------------------------------------
# Sync Configuration
# --------------------------------------------
# Data API writes notes into local Joplin Desktop. Cloud sync is owned by
# Joplin Desktop's sync settings and status.
# true: show a Desktop sync reminder after local writes.
# false: only report the local write result.
AUTO_SYNC="true"

# Reserved for legacy/fallback adapters. Data API mode uses JOPLIN_API_TIMEOUT.
SYNC_TIMEOUT="30"


# --------------------------------------------
# Advanced Options
# --------------------------------------------

# Show debug messages (true/false)
DEBUG="false"

# Clipboard command (auto-detected, usually don't need to change)
# macOS: pbpaste
# Linux: xclip -selection clipboard -o
# Windows WSL: powershell.exe Get-Clipboard
CLIPBOARD_CMD=""

# Editor for viewing notes (leave empty to use Joplin default)
# Examples: nano, vim, code, subl
EDITOR=""


# --------------------------------------------
# Customization Tips
# --------------------------------------------
#
# 1. Multiple Tags:
#    TEMPLATE_TAGS_LEARN="#article #javascript #frontend #draft"
#
# 2. Different Date Format:
#    DATE_FORMAT="%d/%m/%Y"  # 16/02/2026
#    DATE_FORMAT="%B %d, %Y"  # February 16, 2026
#
# 3. Custom Notebook Structure:
#    NOTEBOOK_DAILY="📅 Daily"
#    NOTEBOOK_POST="📝 Articles"
#    NOTEBOOK_WEEKLY="📊 Reviews"
#
# 4. Localized Note Titles:
#    DAILY_NOTE_TITLE_TEMPLATE="{DATE} 學習記錄"  # Chinese
#    DAILY_NOTE_TITLE_TEMPLATE="{DATE} Aprendizaje"  # Spanish
#
