#!/bin/bash
# Create a learning article in Joplin Desktop through the Data API.

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=../lib/joplin_data_api.sh
source "$PROJECT_DIR/lib/joplin_data_api.sh"

CONFIG_FILE="$HOME/.config/joplin-workflow/config"

NOTEBOOK_POST="Blog Posts"
NOTEBOOK_POST_ID=""
TEMPLATE_TAGS_LEARN="#article #draft"
DATE_FORMAT="%Y-%m-%d"
TIME_FORMAT="%H:%M"
AUTO_SYNC="true"
DEBUG="false"
JOPLIN_WRITE_ADAPTER="data_api"
JOPLIN_API_BASE_URL="${JOPLIN_API_BASE_URL:-}"
JOPLIN_API_TOKEN="${JOPLIN_API_TOKEN:-}"
JOPLIN_API_PORT_START="${JOPLIN_API_PORT_START:-41184}"
JOPLIN_API_PORT_END="${JOPLIN_API_PORT_END:-41194}"
JOPLIN_API_TIMEOUT="${JOPLIN_API_TIMEOUT:-5}"
CLIPBOARD_CMD=""
DRY_RUN="false"

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

ARGS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            cat << EOF
Usage: learn [--dry-run] "Article Title"

Create a learning article in the configured Joplin notebook.
Content is read from clipboard and written through Joplin Desktop Data API.

Options:
  --dry-run  Resolve the target notebook and show the planned write without creating notes or tags.

Configuration:
  Edit ~/.config/joplin-workflow/config to customize:
  - NOTEBOOK_POST_ID: Target notebook folder ID, preferred
  - NOTEBOOK_POST: Target notebook title fallback
  - JOPLIN_API_TOKEN: Joplin Desktop Data API token
  - JOPLIN_API_BASE_URL: Optional explicit Data API base URL

See: docs/usage.md for detailed examples
EOF
            exit 0
            ;;
        --dry-run)
            DRY_RUN="true"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${ARGS[@]}"

if [ "${JOPLIN_WRITE_ADAPTER:-data_api}" != "data_api" ]; then
    jwf_error "Only JOPLIN_WRITE_ADAPTER=data_api is supported by the default workflow."
    echo "Joplin CLI support is legacy/fallback and is not enabled in this command." >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    jwf_error "Usage: learn \"Article Title\""
    echo ""
    echo "Example:"
    echo "  echo \"Content\" | pbcopy"
    echo "  learn \"React Hooks Deep Dive\""
    exit 1
fi

TITLE="$1"
CURRENT_DATE=$(date +"$DATE_FORMAT")
CURRENT_TIME=$(date +"$TIME_FORMAT")

CLIPBOARD_CONTENT=$(jwf_clipboard_read)
if [ -z "$CLIPBOARD_CONTENT" ]; then
    jwf_error "Clipboard is empty"
    echo ""
    echo "Please copy content first:"
    echo "  echo \"Your content\" | pbcopy"
    exit 1
fi

joplin_api_init
POST_FOLDER_ID=$(joplin_resolve_folder_id "$NOTEBOOK_POST_ID" "$NOTEBOOK_POST" "post")

NOTE_BODY="# ${TITLE}

> 📅 Created: ${CURRENT_DATE} ${CURRENT_TIME}
> 🏷️ Tags: ${TEMPLATE_TAGS_LEARN}

---

${CLIPBOARD_CONTENT}

---

## TODO
- [ ] Add implementation examples
- [ ] Add resource links
- [ ] Proofread and format
"

if [ "$DRY_RUN" = "true" ]; then
    echo "Dry run: no notes or tags were written."
    echo "Would create learning article"
    echo "Title: ${TITLE}"
    echo "Notebook: ${NOTEBOOK_POST}"
    echo "Notebook ID: ${POST_FOLDER_ID}"
    echo "Tags: ${TEMPLATE_TAGS_LEARN}"
    exit 0
fi

NOTE_RESPONSE=$(joplin_create_note "$TITLE" "$NOTE_BODY" "$POST_FOLDER_ID")
NOTE_ID=$(printf '%s' "$NOTE_RESPONSE" | jq -r '.id // empty')

if [ -z "$NOTE_ID" ]; then
    jwf_error "Failed to read created note ID from Joplin Data API response."
    exit 1
fi

if ! joplin_apply_tags "$NOTE_ID" "$TEMPLATE_TAGS_LEARN"; then
    echo "Note content was created, but one or more tags could not be attached." >&2
fi

echo "✅ Learning article created!"
echo "📝 Title: ${TITLE}"
echo "📁 Notebook: ${NOTEBOOK_POST}"
echo "🔗 ID: ${NOTE_ID}"
jwf_desktop_sync_message
echo ""
echo "💡 View or edit the note in Joplin Desktop."

exit 0
