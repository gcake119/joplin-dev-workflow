#!/bin/bash
# Create a weekly review note in Joplin Desktop through the Data API.

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=../lib/joplin_data_api.sh
source "$PROJECT_DIR/lib/joplin_data_api.sh"

CONFIG_FILE="$HOME/.config/joplin-workflow/config"

NOTEBOOK_WEEKLY="Weekly Reviews"
NOTEBOOK_WEEKLY_ID=""
TEMPLATE_TAGS_WEEKLY="#weekly #review"
DATE_FORMAT="%Y-%m-%d"
TIME_FORMAT="%H:%M"
WEEK_DATE_FORMAT="%Y-%m-%d"
AUTO_SYNC="true"
DEBUG="false"
JOPLIN_WRITE_ADAPTER="data_api"
JOPLIN_API_BASE_URL="${JOPLIN_API_BASE_URL:-}"
JOPLIN_API_TOKEN="${JOPLIN_API_TOKEN:-}"
JOPLIN_API_PORT_START="${JOPLIN_API_PORT_START:-41184}"
JOPLIN_API_PORT_END="${JOPLIN_API_PORT_END:-41194}"
JOPLIN_API_TIMEOUT="${JOPLIN_API_TIMEOUT:-5}"
CLIPBOARD_CMD=""
DRY_RUN="false"

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

get_week_range() {
    local day_of_week
    local days_to_monday
    day_of_week=$(date +%u)
    days_to_monday=$((day_of_week - 1))

    if [[ "${OSTYPE:-}" == "darwin"* ]]; then
        WEEK_START=$(date -v-"${days_to_monday}"d +"$WEEK_DATE_FORMAT")
        WEEK_END=$(date -v+"$((6 - days_to_monday))"d +"$WEEK_DATE_FORMAT")
    else
        WEEK_START=$(date -d "-${days_to_monday} days" +"$WEEK_DATE_FORMAT")
        WEEK_END=$(date -d "+$((6 - days_to_monday)) days" +"$WEEK_DATE_FORMAT")
    fi
}

ARGS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            cat << EOF
Usage: weekly [--dry-run] "Week Title"

Create a weekly review note with automatic Monday-to-Sunday date range.
Content is read from clipboard and written through Joplin Desktop Data API.

Options:
  --dry-run  Resolve the target notebook and show the planned write without creating notes or tags.

Configuration:
  Edit ~/.config/joplin-workflow/config to customize:
  - NOTEBOOK_WEEKLY_ID: Target notebook folder ID, preferred
  - NOTEBOOK_WEEKLY: Target notebook title fallback
  - JOPLIN_API_TOKEN: Joplin Desktop Data API token

See: docs/usage.md for detailed examples
EOF
            exit 0
            ;;
        --dry-run)
            DRY_RUN="true"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${ARGS[@]}"

if [ "${JOPLIN_WRITE_ADAPTER:-data_api}" != "data_api" ]; then
    jwf_error "Only JOPLIN_WRITE_ADAPTER=data_api is supported by the default workflow."
    echo "Joplin CLI support is legacy/fallback and is not enabled in this command." >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    jwf_error "Usage: weekly \"Week Title\""
    echo ""
    echo "Example:"
    echo "  echo \"Week summary\" | pbcopy"
    echo "  weekly \"W07 Learning Summary\""
    exit 1
fi

TITLE="$1"
CURRENT_DATE=$(date +"$DATE_FORMAT")
CURRENT_TIME=$(date +"$TIME_FORMAT")
get_week_range

CLIPBOARD_CONTENT=$(jwf_clipboard_read)
if [ -z "$CLIPBOARD_CONTENT" ]; then
    jwf_error "Clipboard is empty"
    echo ""
    echo "Please copy content first:"
    echo "  echo \"Your weekly summary\" | pbcopy"
    exit 1
fi

joplin_api_init
WEEKLY_FOLDER_ID=$(joplin_resolve_folder_id "$NOTEBOOK_WEEKLY_ID" "$NOTEBOOK_WEEKLY" "weekly")

NOTE_BODY="# ${TITLE}

> 📅 Week: ${WEEK_START} ~ ${WEEK_END}
> 📝 Created: ${CURRENT_DATE}
> 🏷️ Tags: ${TEMPLATE_TAGS_WEEKLY}

---

${CLIPBOARD_CONTENT}

---

## Weekly Stats
- ⏱️ **Learning Hours**: ___ hours
- 📚 **Completed Courses**: ___
- 💻 **Projects**: ___

## Next Week Plan
- [ ] 

## Reflection & Improvements
"

if [ "$DRY_RUN" = "true" ]; then
    echo "Dry run: no notes or tags were written."
    echo "Would create weekly review"
    echo "Title: ${TITLE}"
    echo "Week: ${WEEK_START} ~ ${WEEK_END}"
    echo "Notebook: ${NOTEBOOK_WEEKLY}"
    echo "Notebook ID: ${WEEKLY_FOLDER_ID}"
    echo "Tags: ${TEMPLATE_TAGS_WEEKLY}"
    exit 0
fi

NOTE_RESPONSE=$(joplin_create_note "$TITLE" "$NOTE_BODY" "$WEEKLY_FOLDER_ID")
NOTE_ID=$(printf '%s' "$NOTE_RESPONSE" | jq -r '.id // empty')

if [ -z "$NOTE_ID" ]; then
    jwf_error "Failed to read created note ID from Joplin Data API response."
    exit 1
fi

if ! joplin_apply_tags "$NOTE_ID" "$TEMPLATE_TAGS_WEEKLY"; then
    echo "Note content was created, but one or more tags could not be attached." >&2
fi

echo "✅ Weekly review created!"
echo "📝 Title: ${TITLE}"
echo "📅 Week: ${WEEK_START} ~ ${WEEK_END}"
echo "📁 Notebook: ${NOTEBOOK_WEEKLY}"
echo "🔗 ID: ${NOTE_ID}"
jwf_desktop_sync_message
echo ""
echo "💡 View or edit the note in Joplin Desktop."

exit 0
