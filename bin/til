#!/bin/bash
# Append a Today I Learned entry to a Joplin Desktop daily note through the Data API.

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=../lib/joplin_data_api.sh
source "$PROJECT_DIR/lib/joplin_data_api.sh"

CONFIG_FILE="$HOME/.config/joplin-workflow/config"

NOTEBOOK_DAILY="Daily Notes"
NOTEBOOK_DAILY_ID=""
TEMPLATE_TAGS_TIL="#til #daily"
DATE_FORMAT="%Y-%m-%d"
TIME_FORMAT="%H:%M"
AUTO_SYNC="true"
DEBUG="false"
DAILY_NOTE_TITLE_TEMPLATE="{DATE} Daily Notes"
JOPLIN_WRITE_ADAPTER="data_api"
JOPLIN_API_BASE_URL="${JOPLIN_API_BASE_URL:-}"
JOPLIN_API_TOKEN="${JOPLIN_API_TOKEN:-}"
JOPLIN_API_PORT_START="${JOPLIN_API_PORT_START:-41184}"
JOPLIN_API_PORT_END="${JOPLIN_API_PORT_END:-41194}"
JOPLIN_API_TIMEOUT="${JOPLIN_API_TIMEOUT:-5}"
CLIPBOARD_CMD=""
DRY_RUN="false"

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

ARGS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            cat << EOF
Usage: til [--dry-run] ["Concept Name"]

Append a Today I Learned entry to today's daily note.
Content is read from clipboard and written through Joplin Desktop Data API.
If no title is given, the first line of the clipboard is used as the title.

Options:
  --dry-run  Resolve the target note/notebook and show whether TIL would append or create without writing notes or tags.

Configuration:
  Edit ~/.config/joplin-workflow/config to customize:
  - NOTEBOOK_DAILY_ID: Target notebook folder ID, preferred
  - NOTEBOOK_DAILY: Target notebook title fallback
  - DAILY_NOTE_TITLE_TEMPLATE: Daily note title template
  - JOPLIN_API_TOKEN: Joplin Desktop Data API token

See: docs/usage.md for detailed examples
EOF
            exit 0
            ;;
        --dry-run)
            DRY_RUN="true"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${ARGS[@]}"

if [ "${JOPLIN_WRITE_ADAPTER:-data_api}" != "data_api" ]; then
    jwf_error "Only JOPLIN_WRITE_ADAPTER=data_api is supported by the default workflow."
    echo "Joplin CLI support is legacy/fallback and is not enabled in this command." >&2
    exit 1
fi

CLIPBOARD_CONTENT=$(jwf_clipboard_read)
if [ -z "$CLIPBOARD_CONTENT" ]; then
    jwf_error "Clipboard is empty"
    echo ""
    echo "Please copy content first:"
    echo "  echo \"Your learning\" | pbcopy"
    exit 1
fi

if [ $# -eq 0 ]; then
    CONCEPT=$(printf '%s\n' "$CLIPBOARD_CONTENT" | head -n 1 | sed 's/^[#[:space:]]*//')
    echo "💡 No title provided, using first line: \"${CONCEPT}\""
else
    CONCEPT="$1"
fi

CURRENT_DATE=$(date +"$DATE_FORMAT")
CURRENT_TIME=$(date +"$TIME_FORMAT")
TODAY_TITLE="${DAILY_NOTE_TITLE_TEMPLATE/\{DATE\}/$CURRENT_DATE}"

NEW_TIL_BLOCK="
## [${CURRENT_TIME}] ${CONCEPT}

${CLIPBOARD_CONTENT}
"

joplin_api_init
DAILY_FOLDER_ID=$(joplin_resolve_folder_id "$NOTEBOOK_DAILY_ID" "$NOTEBOOK_DAILY" "daily")

set +e
NOTE_ID=$(joplin_find_note_by_title_in_folder "$TODAY_TITLE" "$DAILY_FOLDER_ID")
NOTE_STATUS=$?
set -e

if [ "$NOTE_STATUS" -eq 0 ]; then
    if [ "$DRY_RUN" = "true" ]; then
        echo "Dry run: no notes or tags were written."
        echo "Would append to today's note"
        echo "Concept: ${CONCEPT}"
        echo "Daily note title: ${TODAY_TITLE}"
        echo "Notebook: ${NOTEBOOK_DAILY}"
        echo "Notebook ID: ${DAILY_FOLDER_ID}"
        echo "Note ID: ${NOTE_ID}"
        echo "Tags: ${TEMPLATE_TAGS_TIL}"
        exit 0
    fi

    echo "📌 Found today's note, appending..."
    EXISTING_BODY=$(joplin_get_note_body "$NOTE_ID")
    UPDATED_BODY="${EXISTING_BODY}${NEW_TIL_BLOCK}"
    joplin_update_note_body "$NOTE_ID" "$UPDATED_BODY" >/dev/null

    echo "✅ TIL appended!"
    echo "📝 Concept: ${CONCEPT}"
    echo "⏰ Time: ${CURRENT_TIME}"
    echo "🔗 Note ID: ${NOTE_ID}"
elif [ "$NOTE_STATUS" -eq 2 ]; then
    if [ "$DRY_RUN" = "true" ]; then
        echo "Dry run: no notes or tags were written."
        echo "Would create today's note"
        echo "Concept: ${CONCEPT}"
        echo "Daily note title: ${TODAY_TITLE}"
        echo "Notebook: ${NOTEBOOK_DAILY}"
        echo "Notebook ID: ${DAILY_FOLDER_ID}"
        echo "Tags: ${TEMPLATE_TAGS_TIL}"
        exit 0
    fi

    echo "📄 Today's note not found, creating..."
    NEW_NOTE_BODY="# ${TODAY_TITLE}

> 🗓️ Date: ${CURRENT_DATE}
> 🏷️ Tags: ${TEMPLATE_TAGS_TIL}

${NEW_TIL_BLOCK}"

    NOTE_RESPONSE=$(joplin_create_note "$TODAY_TITLE" "$NEW_NOTE_BODY" "$DAILY_FOLDER_ID")
    NOTE_ID=$(printf '%s' "$NOTE_RESPONSE" | jq -r '.id // empty')
    if [ -z "$NOTE_ID" ]; then
        jwf_error "Failed to read created note ID from Joplin Data API response."
        exit 1
    fi

    echo "✅ Today's note created with TIL!"
    echo "📝 Concept: ${CONCEPT}"
    echo "🔗 Note ID: ${NOTE_ID}"
else
    exit "$NOTE_STATUS"
fi

if ! joplin_apply_tags "$NOTE_ID" "$TEMPLATE_TAGS_TIL"; then
    echo "Note content was written, but one or more tags could not be attached." >&2
fi

jwf_desktop_sync_message
echo ""
echo "💡 View or edit the note in Joplin Desktop."

exit 0
